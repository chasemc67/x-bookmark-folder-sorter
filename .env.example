# Local secrets — copy to `.env` for local runs (never commit `.env`).
# In production every secret lives in Vercel env (Project Settings -> Environment Variables).

# --- Jev via Vercel AI Gateway (server-only) ------------------------------------
# Jev is called only through Vercel AI Gateway, never the TypeSafe API directly.
# Create a key in the Vercel AI Gateway:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=
# Must be typesafe-ai/jev (the default); any other value is rejected.
JEV_MODEL=typesafe-ai/jev
# Total deadline per Jev batch, including the one permitted retry.
JEV_TIMEOUT_MS=15000
GATEWAY_ZERO_DATA_RETENTION=false
JEV_BATCH_SIZE=10
MAX_TEXT_CHARS=400

# --- Safety -----------------------------------------------------------------
# Dry run is the default. Only DRY_RUN=false (or 0/no) enables live writes.
# Live mode only ADDS already-bookmarked posts into existing folders; it never deletes bookmarks.
DRY_RUN=true
# Minimum Jev probability AND confidence to file an unfiled bookmark.
MIN_CONFIDENCE=0.7
# Re-classify bookmarks already in a folder and report likely misfiles.
CHECK_MISFILED=true
# Actually move misfiled bookmarks (live mode only). Off by default: report only.
REFILE_MISFILED=false
MISFILED_MIN_CONFIDENCE=0.9
MAX_BOOKMARKS_PER_RUN=200
MAX_WRITES_PER_RUN=50

# Optional folder hints and exclusions (folder names as they appear in X).
# FOLDER_DESCRIPTIONS={"AI":"machine learning papers, models, and tooling","Recipes":"cooking and food"}
# EXCLUDED_FOLDERS=Read later,Personal

# --- Vercel cron --------------------------------------------------------------
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- X (OAuth 2.0 user context, your own X developer app) ---------------------------
# The cron calls the X API directly with these credentials; no bot/agent X connector is involved.
# Scopes: tweet.read users.read bookmark.read bookmark.write offline.access
# Optional: fetched from /2/users/me when unset.
X_USER_ID=
X_CLIENT_ID=
# Only for confidential ("Web App, Automated App or Bot") clients.
X_CLIENT_SECRET=
# Seed/fallback refresh token from `npm run auth:x -- --print-refresh-token`.
X_REFRESH_TOKEN=
# X_REDIRECT_URI=http://127.0.0.1:8787/callback

# X refresh tokens rotate on every use, so the current one must be persisted between runs.
# Connecting Upstash Redis from the Vercel Marketplace sets these in Vercel env automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# X_TOKEN_STORE_KEY=x-bookmark-folder-sorter:x-oauth

# Quick local testing only: a user access token (expires after ~2 hours).
X_ACCESS_TOKEN=
