# Secrets only. Every tunable lives in config/sorter.ts, and X OAuth lives in Vercel Connect.
# In production set these in Vercel env. Locally, prefer `vercel link` + `vercel env pull`, which
# writes .env.local with these values plus the VERCEL_OIDC_TOKEN that Vercel Connect needs.
# A hand-written `.env` also works for these two (never commit either file).

# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=

# Jev via Vercel AI Gateway (server-only). Create a key:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# No X_CLIENT_ID / X_CLIENT_SECRET / KV_* here: the X app credentials and the user's grant are
# stored in the Vercel Connect connector (xConnectConnector in config/sorter.ts).
