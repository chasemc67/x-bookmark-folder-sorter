# Secrets only — copy to `.env` for local runs (never commit `.env`).
# In production set these in Vercel env. Every tunable lives in config/sorter.ts instead.

# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=

# Jev via Vercel AI Gateway (server-only). Create a key:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Your X developer app (OAuth 2.0). X_CLIENT_SECRET only for confidential clients.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Upstash Redis (set automatically when connected from the Vercel Marketplace).
# Holds the rotating X OAuth tokens that `npm run auth:x` seeds.
KV_REST_API_URL=
KV_REST_API_TOKEN=
