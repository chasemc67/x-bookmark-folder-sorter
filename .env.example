# Copy to .env for local runs and fill in. Never commit real keys.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# --- Safety -----------------------------------------------------------------
# Dry run is the default. Only DRY_RUN=false (or 0/no) enables live writes.
# Live mode only ADDS already-bookmarked posts into existing folders; it never deletes bookmarks.
DRY_RUN=true
# Minimum Jev probability AND confidence to file an unfiled bookmark.
MIN_CONFIDENCE=0.7
# Re-classify bookmarks already in a folder and report likely misfiles.
CHECK_MISFILED=true
# Actually move misfiled bookmarks (live mode only). Off by default: report only.
REFILE_MISFILED=false
MISFILED_MIN_CONFIDENCE=0.9
MAX_BOOKMARKS_PER_RUN=200
MAX_WRITES_PER_RUN=50

# --- Vercel cron --------------------------------------------------------------
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Jev ------------------------------------------------------------------------
# Provider is inferred from whichever key is set (JEV_API_KEY wins). Override with JEV_PROVIDER.
# jev      -> https://jevtypesafeai.com/api/v1/decide  (JEV_API_KEY, a jv_live_... key)
# typesafe -> https://api.typesafe.ai/v1/systemone     (TYPESAFE_API_KEY)
# gateway  -> Vercel AI Gateway typesafe-ai/jev, like Jevis (AI_GATEWAY_API_KEY, or Vercel OIDC when deployed)
JEV_API_KEY=
# JEV_PROVIDER=jev
# TYPESAFE_API_KEY=
# AI_GATEWAY_API_KEY=
# JEV_MODEL=
# JEV_API_URL=
JEV_BATCH_SIZE=10
JEV_TIMEOUT_MS=20000
MAX_TEXT_CHARS=400
GATEWAY_ZERO_DATA_RETENTION=false

# Optional folder hints and exclusions (folder names as they appear in X).
# FOLDER_DESCRIPTIONS={"AI":"machine learning papers, models, and tooling","Recipes":"cooking and food"}
# EXCLUDED_FOLDERS=Read later,Personal

# --- X (OAuth 2.0 user context) ----------------------------------------------------
# Scopes: tweet.read users.read bookmark.read bookmark.write offline.access
# Optional: fetched from /2/users/me when unset.
X_USER_ID=

# Recommended for cron: refresh-token flow (run `npm run auth:x` once).
X_CLIENT_ID=
# Only for confidential ("Web App, Automated App or Bot") clients.
X_CLIENT_SECRET=
# Optional seed; X refresh tokens rotate on every use, so the live copy lives in the token store.
X_REFRESH_TOKEN=
# X_REDIRECT_URI=http://127.0.0.1:8787/callback

# Token store for rotated refresh tokens (required on Vercel for the refresh flow).
# Vercel Marketplace Upstash/KV sets KV_REST_API_URL + KV_REST_API_TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# X_TOKEN_STORE_KEY=x-bookmark-folder-sorter:x-oauth

# Quick local testing only: a user access token (expires after ~2 hours).
X_ACCESS_TOKEN=
